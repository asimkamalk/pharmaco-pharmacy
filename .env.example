# Pharmaco environment variables
# Copy to `.env` for local, and set the same keys in Vercel → Project → Settings → Environment Variables

# --- Database (Neon PostgreSQL) ---
# From Neon Console → your project → Connection details:
# - DATABASE_URL = pooled connection (host contains `-pooler`)
# - DIRECT_URL   = direct connection (no `-pooler`) — used by Prisma CLI (migrate/db push)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Public site URL (SEO / canonical). Use your Vercel or custom domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin seed account (`npm run db:seed`) ---
ADMIN_EMAIL="pharmacopharmacy24@gmail.com"
ADMIN_PASSWORD="Tryhard123"

# --- Optional OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
