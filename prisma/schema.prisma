generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  passwordHash  String?
  role          Role      @default(USER)
  /** When true, customer cannot sign in */
  isRestricted  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  prescriptionRequests PrescriptionRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @default("")
  image       String    @default("/images/categories/placeholder.svg")
  imageAlt    String    @default("")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @default("")
  image       String    @default("/images/brands/placeholder.svg")
  imageAlt    String    @default("")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  /** Plain-text short description (cards, meta, hero blurb) */
  description          String         @default("")
  /** Rich HTML long description (headings, lists, links, etc.) */
  longDescription      String         @default("")
  /** SEO meta description for Google / social (~160 chars) */
  metaDescription      String         @default("")
  /** Optional SEO title override (defaults to product name) */
  metaTitle            String         @default("")
  sku                  String         @unique
  /** Wholesale / purchase cost in PKR */
  purchasePrice        Float
  /** Selling price before discount in PKR */
  price                Float
  /** Discount percentage 0–100 */
  discount             Int            @default(0)
  stock                Int            @default(0)
  requiresPrescription Boolean        @default(false)
  isFeatured           Boolean        @default(false)
  isArchived           Boolean        @default(false)
  rating               Float?
  reviewCount          Int            @default(0)
  genericName          String?
  strength             String?
  dosageForm           String?
  manufacturer         String?
  categoryId           String
  brandId              String
  category             Category       @relation(fields: [categoryId], references: [id])
  brand                Brand          @relation(fields: [brandId], references: [id])
  images               ProductImage[]
  orderItems           OrderItem[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isArchived, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String  @default("home")
  customLabel String?
  fullName    String
  phone       String
  email       String?
  addressLine String
  area        String
  city        String
  notes       String?
  isDefault   Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  userId                 String?
  status                 String      @default("pending")
  paymentMethod          String
  paymentStatus          String      @default("not_required")
  paymentReference       String?
  prescriptionReference  String?
  /** Uploaded prescription file (image or PDF) */
  prescriptionUrl        String?
  prescriptionFileName   String?
  prescriptionMimeType   String?
  /** not_required | pending_review | approved | rejected */
  prescriptionStatus     String   @default("not_required")
  prescriptionAdminNote  String?
  customerName           String
  customerPhone          String
  customerEmail          String
  addressLabel           String
  addressCustomLabel     String?
  addressLine            String
  area                   String
  city                   String
  orderNotes             String?
  subtotal               Float
  discountTotal          Float       @default(0)
  deliveryFee            Float       @default(0)
  /** Total purchase/cost of goods for this order (for profit reports) */
  costTotal              Float       @default(0)
  grandTotal             Float
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  prescriptionRequest    PrescriptionRequest?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

/** Customer submitted a prescription for the pharmacy to build an order */
model PrescriptionRequest {
  id                   String   @id @default(cuid())
  requestNumber        String   @unique
  userId               String?
  /** pending | in_progress | fulfilled | rejected | cancelled */
  status               String   @default("pending")
  customerName         String
  customerPhone        String
  customerEmail        String?
  addressLabel         String   @default("home")
  addressCustomLabel   String?
  addressLine          String
  area                 String
  city                 String
  prescriptionUrl      String
  prescriptionFileName String?
  prescriptionMimeType String?
  /** What the customer says they need, e.g. "I need Augmentin and Panadol" */
  medicinesNote        String
  adminNote            String?
  orderId              String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order                Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String?
  name                 String
  slug                 String
  image                String
  sku                  String
  quantity             Int
  unitPrice            Float
  /** Snapshot of purchase cost at order time */
  purchasePrice        Float   @default(0)
  discount             Int     @default(0)
  requiresPrescription Boolean @default(false)
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

/** Singleton store settings (id is always "default") */
model SiteSettings {
  id                   String   @id @default("default")
  name                 String   @default("Pharmaco Pharmacy")
  shortName            String   @default("Pharmaco")
  tagline              String   @default("Your trusted pharmacy in Hayatabad, Peshawar")
  description          String   @default("")
  area                 String   @default("Hayatabad")
  city                 String   @default("Peshawar")
  country              String   @default("Pakistan")
  address              String   @default("")
  phone                String   @default("")
  whatsapp             String   @default("")
  email                String   @default("")
  openingHours         String   @default("")
  deliveryStandardFee  Float    @default(150)
  freeDeliveryAbove    Float    @default(2000)
  deliveryEstimate     String   @default("")
  bankName             String   @default("")
  bankAccountTitle     String   @default("")
  bankAccountNumber    String   @default("")
  bankIban             String   @default("")
  easyPaisaTitle       String   @default("")
  easyPaisaNumber      String   @default("")
  jazzCashTitle        String   @default("")
  jazzCashNumber       String   @default("")
  mapEmbedUrl          String   @default("")
  mapLinkUrl           String   @default("")
  logoUrl              String   @default("/images/pharmaco-logo-text.png")
  logoAlt              String   @default("Pharmaco Pharmacy")
  facebookUrl          String   @default("")
  instagramUrl         String   @default("")
  tiktokUrl            String   @default("")
  twitterUrl           String   @default("")
  seoTitle             String   @default("")
  seoDescription       String   @default("")
  heroEyebrow          String   @default("")
  heroHeadline         String   @default("Your health, delivered with care")
  heroSubcopy          String   @default("")
  heroCtaPrimaryLabel  String   @default("Shop now")
  heroCtaPrimaryHref   String   @default("/shop")
  heroCtaSecondaryLabel String  @default("Contact us")
  heroCtaSecondaryHref String   @default("/contact")
  /** Optional full-bleed hero background image */
  heroBackgroundUrl    String   @default("")
  /** Optional right-side hero image (desktop) */
  heroImageUrl         String   @default("/images/pharmaco-logo.png")
  promoHeadline        String   @default("")
  promoSubcopy         String   @default("")
  whyChooseJson        String   @default("[]")
  /** Homepage “Order by prescription” block */
  rxOrderHeadline      String   @default("Order by prescription")
  rxOrderSubcopy       String   @default("")
  rxOrderStep1         String   @default("")
  rxOrderStep2         String   @default("")
  rxOrderStep3         String   @default("")
  rxOrderCtaLabel      String   @default("Order by prescription")
  updatedAt            DateTime @updatedAt
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  bodyHtml    String   @default("")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** Homepage hero carousel slides (full-bleed background images) */
model HeroSlide {
  id                 String   @id @default(cuid())
  sortOrder          Int      @default(0)
  eyebrow            String   @default("")
  headline           String
  subcopy            String   @default("")
  ctaLabel           String   @default("Shop now")
  ctaHref            String   @default("/shop")
  ctaSecondaryLabel  String   @default("")
  ctaSecondaryHref   String   @default("")
  backgroundUrl      String
  backgroundAlt      String   @default("")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/** Uploaded media library (alt text + file metadata for SEO) */
model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  filename  String
  folder    String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@unique([url])
}
