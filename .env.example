# Pharmaco Auth.js environment variables
# Copy these into your local .env file (never commit .env)

# Required — local SQLite database (created automatically by Prisma)
DATABASE_URL="file:./dev.db"

# Required — random secret for signing sessions (generate a new one for production)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public site URL used for SEO (canonical, sitemap, Open Graph, JSON-LD)
# Set this to your real domain in production, e.g. https://pharmaco.pk
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — Google OAuth (leave blank until configured)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional — Facebook OAuth (leave blank until configured)
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Admin seed account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@pharmaco.local"
ADMIN_PASSWORD="Admin@12345"
